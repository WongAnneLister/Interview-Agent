# 复制为 .env 后填写。.env 不能提交（pre-commit 会拦截）。
# 各配置项会在后续 PR 中逐步加入，每一项都要写清楚用途。

# --- 运行环境 ---
# APP_ENV=dev

# --- VPS（开发依赖部署在 VPS 上，见 deploy/vps/ 和 scripts/）---
# 需要已配置 SSH 密钥免密登录
VPS_HOST=your.vps.ip
VPS_PORT=22
VPS_USER=root
VPS_DIR=/opt/interview-agent

# --- 数据库、缓存、对象存储、监控 ---
# 以下区块由 `make vps-env` 从 VPS 读取后自动写入 .env，不要手填：
# DATABASE_URL / REDIS_URL / S3_* / GRAFANA_* / PROMETHEUS_URL
# 本机指标端口（tunnel.sh 反向转发给 VPS 上的 Prometheus）
API_METRICS_PORT=8000
WORKER_METRICS_PORT=9465

# --- LiveKit（本机原生运行，见 scripts/livekit.sh）---
# 首次运行 `make livekit` 时若未填写，会自动生成密钥并追加到 .env
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- 模型厂商（PR-07 / PR-08 / PR-09 加入；型号以百炼控制台当前可用的为准）---

# --- 可观测性（PR-04b / PR-04c 加入）---
