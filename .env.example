# 复制为 .env 后填写。.env 不能提交（pre-commit 会拦截）。
# 各配置项会在后续 PR 中逐步加入，每一项都要写清楚用途。

# --- 运行环境（backend/src/interview/config.py 读取；留空的项视为未配置）---
# dev / test / prod
APP_ENV=dev
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# json：结构化 JSON（默认，生产用）；console：彩色可读格式（本机开发时可切换）
LOG_FORMAT=json
# v0 唯一的本地用户 id：`make migrate` 后运行 `make seed` 自动创建并写入 .env，不要手填
DEFAULT_USER_ID=
# 允许跨域访问 API 的前端地址（JSON 数组）；留空表示不允许任何跨域请求
WEB_ORIGINS=["http://localhost:3000"]
# /readyz 每项依赖检查的超时（秒，默认 3）；经 SSH 隧道连 VPS 时新建连接约 10 秒，本机开发建议 20
READY_CHECK_TIMEOUT_S=20
# 文字面试 WebSocket（PR-20）：多少秒收不到客户端任何消息（含 ping）就视为断线（默认 60；前端每 20 秒 ping 一次）
WS_IDLE_TIMEOUT_S=60
# 服务端推进阶段 / 思考超时的 tick 间隔（秒，默认 1）
WS_TICK_INTERVAL_S=1

# --- VPS（开发依赖部署在 VPS 上，见 deploy/vps/ 和 scripts/）---
# 需要已配置 SSH 密钥免密登录
VPS_HOST=your.vps.ip
VPS_PORT=22
VPS_USER=root
VPS_DIR=/opt/interview-agent

# --- 数据库、缓存、对象存储、监控 ---
# 以下区块由 `make vps-env` 从 VPS 读取后自动写入 .env，不要手填：
# DATABASE_URL / REDIS_URL / S3_* / GRAFANA_* / PROMETHEUS_URL
# 其中必填（缺失时启动即报错）：DATABASE_URL、REDIS_URL、S3_ENDPOINT、S3_ACCESS_KEY、S3_SECRET_KEY
# 可选：S3_REGION（默认 us-east-1）、S3_BUCKET_RECORDINGS（默认 recordings）、S3_BUCKET_RESUMES（默认 resumes）
# 本机指标端口（tunnel.sh 反向转发给 VPS 上的 Prometheus）
API_METRICS_PORT=8000
WORKER_METRICS_PORT=9465
EVAL_METRICS_PORT=9466

# --- LiveKit（本机原生运行，见 scripts/livekit.sh）---
# 首次运行 `make livekit` 时若未填写，会自动生成密钥并追加到 .env
# 三项都必填（缺失时启动即报错）
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- 模型厂商（PR-07 / PR-08 / PR-09 加入；型号以百炼控制台当前可用的为准）---
# 按角色配置，每个角色四项：<角色>_PROVIDER（厂商名）、<角色>_MODEL（型号）、
# <角色>_BASE_URL（接口地址）、<角色>_TIMEOUT_S（单次调用超时秒数，默认 30）。
# 代码里不写死任何型号和地址；PROVIDER 或 MODEL 留空表示该角色尚未配置。
# PROVIDER=fake 使用确定输出的假实现（无需密钥，本地联调用），MODEL 随便填一个名字即可。
# 厂商级密钥与默认地址（多个角色共用；角色的 BASE_URL 留空时用这里的地址）
# 百炼（阿里云 Model Studio）：同一个密钥也用于识别和合成；北京地域 OpenAI 兼容地址，
# 也可以换成控制台给出的业务空间专属地址 https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼原生 API 地址（热词表 tools/create_hotwords.py 等使用）
BAILIAN_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# DeepSeek（备用大模型）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 大模型角色另有一项 <角色>_EXTRA_BODY：透传给厂商的非标准参数（JSON），配置后整体替换代码默认值。
# 型号以百炼控制台当前可用的 Flash / Max 型号为准（单价写在 backend/config/pricing.yaml）。
# 前台面试官大模型（低延迟，流式）；EXTRA_BODY 默认 {"enable_thinking": false}（关闭思考）
LLM_FRONT_PROVIDER=bailian
LLM_FRONT_MODEL=
LLM_FRONT_BASE_URL=
LLM_FRONT_TIMEOUT_S=30
LLM_FRONT_EXTRA_BODY=
# 评估 / 出题 / 报告大模型（重质量）；EXTRA_BODY 默认为空（按型号默认决定是否思考）
LLM_EVAL_PROVIDER=bailian
LLM_EVAL_MODEL=
LLM_EVAL_BASE_URL=
LLM_EVAL_TIMEOUT_S=30
LLM_EVAL_EXTRA_BODY=
# 面试中的实时评估（每轮决定追问还是换题，要在 2.5 秒内返回）；不配置时回退到 LLM_EVAL_*。
# 2026-10-18 实测只有 deepseek-flash 关思考接近 2.5 秒，百炼 max / flash 都要 6–8 秒，见 docs/challenges.md C1。
# EXTRA_BODY 默认为空，用 DeepSeek 时务必关闭思考：{"thinking": {"type": "disabled"}}
LLM_LIVE_EVAL_PROVIDER=deepseek
LLM_LIVE_EVAL_MODEL=
LLM_LIVE_EVAL_BASE_URL=
LLM_LIVE_EVAL_TIMEOUT_S=10
LLM_LIVE_EVAL_EXTRA_BODY={"thinking": {"type": "disabled"}}
# 备用大模型（主厂商超时 / 限流 / 不可用时切换）；EXTRA_BODY 默认 {"thinking": {"type": "disabled"}}
# （DeepSeek 默认开启思考，备用时优先保证延迟）
LLM_FALLBACK_PROVIDER=deepseek
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_TIMEOUT_S=30
LLM_FALLBACK_EXTRA_BODY=
# 流式语音识别（百炼 Fun-ASR 实时，WebSocket；密钥用 BAILIAN_API_KEY）
# TIMEOUT_S 用于建连、等任务开始、每次发送和结束时等待结果；说话过程中不设超时。
# EXTRA_BODY 合并进 run-task 的 parameters，默认为空（不设 language_hints，自动识别中英混说），
# 例如 {"language_hints": ["zh"], "max_sentence_silence": 800}
STT_PROVIDER=bailian
STT_MODEL=fun-asr-realtime
STT_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
STT_TIMEOUT_S=10
STT_EXTRA_BODY=
# 流式语音合成（百炼 CosyVoice 任务协议，WebSocket；密钥用 BAILIAN_API_KEY）
# VOICE：默认音色（cosyvoice-v3-flash 的系统音色，如 longanlang_v3、longshuo_v3、longanwen_v3）。
# EXTRA_BODY 合并进 run-task 的 parameters，如 {"rate": 1.1, "volume": 60}。
# PROVIDER=bailian_realtime 走 Qwen-TTS Realtime 协议，用 Qwen3-TTS 音色（如 Ryan、Bodega）：
#   TTS_MODEL=qwen3-tts-flash-realtime
#   TTS_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
#   EXTRA_BODY 合并进 session.update，如 {"speech_rate": 1.1, "volume": 60}
TTS_PROVIDER=bailian
TTS_MODEL=cosyvoice-v3-flash
TTS_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
TTS_VOICE=
TTS_TIMEOUT_S=10
TTS_EXTRA_BODY=

# --- 可观测性（PR-04b / PR-04c 加入）---
# 总开关：true 时链路通过 OTLP 发到 Langfuse、指标端口对外暴露；false 时所有埋点工具都是空操作（代码默认 false）
OBSERVABILITY_ENABLED=true
# 链路采样比例（0–1），按 trace 整条采样；开发期用 1 全量记录
OBSERVABILITY_SAMPLE_RATIO=1.0
# Langfuse 运行在本机 Docker（make obs-up），以下几项由 scripts/langfuse-local-init.sh 写入 langfuse-local 区块：
# LANGFUSE_HOST：本机地址（http://127.0.0.1:23100），OTLP 发送到 <HOST>/api/public/otel
# LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY：首次启动时自动创建的项目密钥
# LANGFUSE_ADMIN_EMAIL / LANGFUSE_ADMIN_PASSWORD：Langfuse 网页登录账号

# --- 用量与成本（PR-04c 加入）---
# 厂商单价表路径；留空使用 backend/config/pricing.yaml（单价以厂商官方价格页为准）
PRICING_FILE=
# 单场预算（元，默认 5）：估算成本达到 80% 时 budget.check() 返回 warn，达到 100% 返回 exceeded
MAX_COST_PER_INTERVIEW_CNY=5
# 每日预算（元，默认 50）：北京时间当天、全部用户、不含评测的估算支出；超出时记错误日志并暴露指标
DAILY_BUDGET_CNY=50
