      "Stage": {
        "description": "与 PR-16 状态机的阶段名一致。",
        "enum": [
          "opening",
          "self_intro",
          "resume_deep_dive",
          "technical",
          "behavioral",
          "candidate_questions",
          "closing"
        ],
        "title": "Stage",
        "type": "string"
      },
      "StageEvent": {
        "properties": {
          "phase": {
            "$ref": "#/components/schemas/Phase"
          },
          "remaining_s": {
            "title": "Remaining S",
            "type": "integer"
          },
          "total_remaining_s": {
            "title": "Total Remaining S",
            "type": "integer"
          },
          "type": {
            "const": "stage",
            "default": "stage",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "phase",
          "remaining_s",
          "total_remaining_s"
        ],
        "title": "StageEvent",
        "type": "object"
      },
      "StageSlot": {
        "description": "一个阶段的时间片。capacity 是无题阶段为 0，有题阶段为 seconds // SECONDS_PER_QUESTION。",
        "properties": {
          "capacity": {
            "minimum": 0.0,
            "title": "Capacity",
            "type": "integer"
          },
          "seconds": {
            "minimum": 0.0,
            "title": "Seconds",
            "type": "integer"
          },
