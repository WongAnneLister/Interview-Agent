            },
            "title": "Work",
            "type": "array"
          }
        },
        "title": "ResumeParsed",
        "type": "object"
      },
      "ResumeReplacement": {
        "description": "整份替换解析结果。每个字段都要出现，缺字段不能靠默认值把已有内容清空。",
        "properties": {
