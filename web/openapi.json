            "$ref": "#/components/schemas/InterviewerSentence"
          },
          {
            "$ref": "#/components/schemas/InterviewerDone"
          },
          {
            "$ref": "#/components/schemas/StateEvent"
          },
          {
            "$ref": "#/components/schemas/StageEvent"
          },
          {
